{
  "name": "@libre-ai/radar-gates",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "packageManager": "bun@1.4.0-canary.1",
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "fast-uri": "4.1.2"
  },
  "devDependencies": {
    "@libre-ai/governance": "github:libre-ai/governance#9cd1d421d318129db99456d963f4bc1cfad67b33",
    "@libre-ai/contracts-authority": "github:libre-ai/contracts#ee144f03cf7d3deeda02a9fcd5e10377c2e99cb4",
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check:bun:runtime": "bun node_modules/@libre-ai/governance/tools/quality/check-bun-minimum.ts",
    "check:bun": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-bun-manifests.ts",
    "check:toolchain": "bun run check:bun && bun node_modules/@libre-ai/governance/tools/quality/check-toolchain.ts",
    "check:app": "bun run check:bun:runtime && bun install --cwd apps/radar && bun test --cwd apps/radar",
    "check:secret-scan": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-secret-scan.ts",
    "check:personal-data": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-personal-data-boundary.ts",
    "lint": "bun run check:bun:runtime && biome ci .",
    "pretest": "bun run check:bun",
    "test": "bun run check:app",
    "check": "bun run check:bun && bun run check:toolchain && bun run check:app && bun run check:secret-scan && bun run check:personal-data && bun run lint"
  }
}
